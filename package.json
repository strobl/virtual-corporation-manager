{
  "name": "gitflash",
  "version": "0.1.0-alpha.4-local.1",
  "description": "A local workspace for your company of AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25 || >=26.0.0 <27"
  },
  "bin": {
    "gitflash": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strobl/virtual-corporation-manager.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:package": "node scripts/packed-smoke.mjs"
  },
  "devDependencies": {
    "@slack/socket-mode": "^3.0.1",
    "@slack/web-api": "^8.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.575.0",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
