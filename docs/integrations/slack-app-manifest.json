{
  "display_information": {
    "name": "VCM",
    "description": "Give a named VCM agent a focused task through your local runtime.",
    "background_color": "#FF5A2A"
  },
  "features": {
    "bot_user": {
      "display_name": "VCM",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
